__pycache__/
*.py[cod]
.venv/
.env
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# Data and run artifacts live outside git (track provenance in docs/data/ instead)
data/raw/*
data/processed/*
data/cache/
!data/raw/.gitkeep
!data/processed/.gitkeep
runs/
*.pt
*.bin
trackio/
.vscode/

# EDA reports: working runs are ignored; a report worth keeping is named final-<something>
reports/eda/*
!reports/eda/final-*/
